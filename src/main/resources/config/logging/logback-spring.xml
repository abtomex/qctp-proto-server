<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
    <include resource="audit-appender.xml"/>

    <springProperty scope="context" name="logsFolder" source="logsToFile.logsFolder"/>
    <springProperty scope="context" name="serviceName" source="rkk.app.serviceName"/>
    <springProperty scope="context" name="bootstrapServers" source="appender.kafka.bootstrap-servers"/>
    <springProperty scope="context" name="mainTopic" source="appender.kafka.topics.main"/>
    <springProperty scope="context" name="errorTopic" source="appender.kafka.topics.error"/>
    <springProperty scope="context" name="protocol" source="appender.kafka.properties.security.protocol"/>
    <springProperty scope="context" name="mechanism" source="appender.kafka.properties.sasl.mechanism"/>
    <springProperty scope="context" name="jaasConfig" source="appender.kafka.properties.sasl.jaas.config"/>
    <springProperty scope="context" name="truststorePassword" source="appender.kafka.ssl.trust-store-password"/>
    <springProperty scope="context" name="truststoreLocation" source="appender.kafka.ssl.trust-store-location"/>
    <springProperty scope="context" name="keystorePassword" source="appender.kafka.ssl.key-store-password"/>
    <springProperty scope="context" name="keystoreLocation" source="appender.kafka.ssl.key-store-location"/>
    <springProperty scope="context" name="logsToElastic" source="logsToElastic"/>

    <conversionRule conversionWord="customColor" converterClass="ru.abtomex.config.LogbackColorful"/>

    <appender name="STDOUT"
              class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %d{HH:mm:ss.SSS} [%thread] %customColor(%-5level%replace( [%X{userId}]){' \[\]', ''}%replace( [%X{apiMethod}]){' \[\]', ''}%replace( [%X{sherlockKey}]){' \[\]', ''} %logger{36} - %msg%n)
            </pattern>
        </encoder>
    </appender>

    <appender name="FILE-AUDIT"
              class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/${serviceName}/main.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <Pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level%replace( [%X{userId}]){' \[\]', ''}%replace( [%X{apiMethod}]){' \[\]', ''}%replace( [%X{sherlockKey}]){' \[\]', ''} %logger{36} - %msg%n
            </Pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- rollover daily -->
            <fileNamePattern>
                ${logsFolder}/%d{yyyy/MM/dd, aux}/main-%d{yyyy-MM-dd-HH}-%i.log
            </fileNamePattern>
            <timeBasedFileNamingAndTriggeringPolicy
                    class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>100MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
        </rollingPolicy>
    </appender>

    <appender name="FILE-ERROR"
              class="ch.qos.logback.core.rolling.RollingFileAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <file>logs/${serviceName}/errors.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <Pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level%replace( [%X{userId}]){' \[\]', ''}%replace( [%X{apiMethod}]){' \[\]', ''}%replace( [%X{sherlockKey}]){' \[\]', ''} %logger{36} - %msg%n
            </Pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- rollover daily -->
            <fileNamePattern>
                ${logsFolder}/%d{yyyy/MM/dd, aux}/errors-%d{yyyy-MM-dd-HH}-%i.log
            </fileNamePattern>
            <timeBasedFileNamingAndTriggeringPolicy
                    class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>100MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
        </rollingPolicy>
    </appender>

    <root level="TRACE">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE-AUDIT"/>
        <appender-ref ref="FILE-ERROR"/>
    </root>

</configuration>
